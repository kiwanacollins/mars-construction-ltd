# Copy this file to .env for local docker-compose use, or set these as
# environment variables in Coolify's application settings (Coolify injects
# them into the containers automatically — do not commit a real .env).

# MySQL root password (used only for the healthcheck and initial container setup)
MYSQL_ROOT_PASSWORD=

# App database credentials (used by both the app and mysql services)
DB_NAME=mars_estate
DB_USER=mars
DB_PASS=
